{
  "name": "amethyst-music-desktop",
  "productName": "Amethyst Music",
  "version": "0.1.0",
  "description": "Official Electron desktop client for Amethyst Music servers, with saved-server login and Discord Rich Presence",
  "private": true,
  "author": {
    "name": "qcom-toolbox",
    "email": "169756160+qcom-toolbox@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build": "pnpm run build:renderer && pnpm run build:main && pnpm run build:preload",
    "dist": "pnpm run build && electron-builder",
    "dist:dir": "pnpm run build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "42.9.2",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
